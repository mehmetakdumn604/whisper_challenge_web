---
import { siteConfig } from "../config/site";
---

<section class="hero" aria-labelledby="hero-brand">
  <div class="hero-media" aria-hidden="true">
    <img
      src="/brand/hero.webp"
      alt=""
      width="1600"
      height="1200"
      fetchpriority="high"
    />
    <div class="hero-veil"></div>
  </div>
  <div class="container hero-copy">
    <h1 id="hero-brand">{siteConfig.name}</h1>
    <p class="hero-lede">
      Headphones on. Loud music. Read their lips — then laugh and rematch.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={siteConfig.appStoreUrl}>Download on the App Store</a>
      {
        siteConfig.playStoreUrl ? (
          <a class="btn btn-ghost" href={siteConfig.playStoreUrl}>
            Get it on Google Play
          </a>
        ) : (
          <a class="btn btn-ghost" href="#how">
            See how it works
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 920px);
    display: grid;
    align-items: end;
    overflow: clip;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    animation: float-soft 8s ease-in-out infinite;
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(26, 16, 40, 0.18) 0%,
        rgba(26, 16, 40, 0.35) 42%,
        rgba(26, 16, 40, 0.82) 100%
      ),
      radial-gradient(circle at 70% 20%, rgba(255, 77, 141, 0.25), transparent 45%);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    padding-block: clamp(5rem, 14vw, 8rem) clamp(2.5rem, 7vw, 4.5rem);
    color: #fff8ef;
    animation: rise-in 0.8s var(--ease) both;
  }

  .hero-copy h1 {
    font-size: clamp(3rem, 10vw, 6.2rem);
    max-width: 10ch;
    text-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
  }

  .hero-lede {
    margin-top: 1rem;
    max-width: 34ch;
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    color: rgba(255, 248, 239, 0.9);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.6rem;
  }

  .hero-actions .btn-ghost {
    background: rgba(255, 246, 235, 0.12);
    color: #fff8ef;
    border-color: rgba(255, 248, 239, 0.35);
  }

  .hero-actions .btn-ghost:hover {
    background: rgba(255, 246, 235, 0.22);
  }
</style>
