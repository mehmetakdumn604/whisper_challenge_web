---
const modes = [
  {
    title: "Pass & play",
    text: "Offline party mode for 2–8 players on one device. Easy to Legend decks, built-in noise mix, and unlimited local rounds for free.",
    src: "/brand/videos/lip_read_duo.mp4",
    poster: "/brand/videos/lip_read_duo_poster.webp",
  },
  {
    title: "Online rooms",
    text: "Share a room code, connect with live video, and lip-read across the distance. The guesser sees the reader — not the voice.",
    src: "/brand/videos/modes.mp4",
    poster: "/brand/videos/modes_poster.webp",
  },
];
---

<section class="section modes" id="modes" aria-labelledby="modes-title">
  <div class="container">
    <p class="section-kicker">Play your way</p>
    <h2 class="section-title" id="modes-title">Local chaos or online lip-reads</h2>
    <p class="section-lede">
      Pass one phone around the room — or open a video room when friends are far away.
    </p>

    <div class="modes-split">
      {
        modes.map((mode) => (
          <article class="mode">
            <video
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster={mode.poster}
            >
              <source src={mode.src} type="video/mp4" />
            </video>
            <div class="mode-copy">
              <h3>{mode.title}</h3>
              <p>{mode.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .modes-split {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.4rem;
  }

  .mode {
    position: relative;
    min-height: 320px;
    overflow: hidden;
    border-radius: calc(var(--radius) + 4px);
    isolation: isolate;
    background: var(--dusk);
    box-shadow: var(--shadow);
    animation: rise-in 0.75s var(--ease) both;
  }

  .mode:nth-child(2) {
    animation-delay: 0.1s;
  }

  .mode video {
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: cover;
    display: block;
    transition: transform 0.7s var(--ease);
  }

  .mode:hover video {
    transform: scale(1.04);
  }

  .mode-copy {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.5rem;
    background: linear-gradient(180deg, transparent, rgba(26, 16, 40, 0.9) 55%);
    color: #fff8ef;
  }

  .mode-copy h3 {
    font-size: 1.7rem;
    margin-bottom: 0.4rem;
  }

  .mode-copy p {
    max-width: 36ch;
    color: rgba(255, 248, 239, 0.88);
  }

  @media (min-width: 880px) {
    .modes-split {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }

    .mode {
      min-height: 420px;
    }

    .mode video {
      min-height: 420px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mode:hover video {
      transform: none;
    }
  }
</style>
