---
---

<section class="section modes" id="modes" aria-labelledby="modes-title">
  <div class="container">
    <p class="section-kicker">Play your way</p>
    <h2 class="section-title" id="modes-title">Local chaos or online lip-reads</h2>
    <p class="section-lede">
      Pass one phone around the room — or open a video room when friends are far away.
    </p>

    <div class="modes-split">
      <article class="mode mode-local">
        <img src="/brand/noise.webp" alt="Friends playing Whisper Challenge with headphones" width="900" height="700" loading="lazy" />
        <div class="mode-copy">
          <h3>Pass & play</h3>
          <p>
            Offline party mode for 2–8 players on one device. Easy to Legend decks, built-in noise mix, and unlimited local rounds for free.
          </p>
        </div>
      </article>
      <article class="mode mode-online">
        <img src="/brand/modes.webp" alt="Online Whisper Challenge video match" width="900" height="700" loading="lazy" />
        <div class="mode-copy">
          <h3>Online rooms</h3>
          <p>
            Share a room code, connect with live video, and lip-read across the distance. The guesser sees the reader — not the voice.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .modes-split {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.4rem;
  }

  .mode {
    position: relative;
    min-height: 320px;
    overflow: hidden;
    border-radius: calc(var(--radius) + 4px);
    isolation: isolate;
  }

  .mode img {
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: cover;
  }

  .mode-copy {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.5rem;
    background: linear-gradient(180deg, transparent, rgba(26, 16, 40, 0.88) 55%);
    color: #fff8ef;
  }

  .mode-copy h3 {
    font-size: 1.7rem;
    margin-bottom: 0.4rem;
  }

  .mode-copy p {
    max-width: 36ch;
    color: rgba(255, 248, 239, 0.88);
  }

  @media (min-width: 880px) {
    .modes-split {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }

    .mode {
      min-height: 420px;
    }

    .mode img {
      min-height: 420px;
    }
  }
</style>
