---
const steps = [
  {
    title: "Headphones on",
    text: "The guesser plays loud music so they cannot hear the phrase — only see it.",
  },
  {
    title: "Mouth the phrase",
    text: "The reader says a short line out loud. Exaggerate. Have fun with it.",
  },
  {
    title: "Read the lips",
    text: "Guess correctly, pass, swap roles, and keep the rematch energy going.",
  },
];
---

<section class="section how" id="how" aria-labelledby="how-title">
  <div class="container how-grid">
    <div class="how-intro">
      <p class="section-kicker">How it works</p>
      <h2 class="section-title" id="how-title">A lip-reading party in three beats</h2>
      <p class="section-lede">
        No complicated rules. Just noise in their ears, laughs in yours, and phrases that get weirder every round.
      </p>
      <div class="how-stage" aria-hidden="true">
        <video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/brand/videos/noise_poster.webp"
        >
          <source src="/brand/videos/noise.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
    <ol class="steps">
      {
        steps.map((step, index) => (
          <li class="step">
            <span class="step-index" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how-grid {
    display: grid;
    gap: 2.5rem;
  }

  .how-stage {
    margin-top: 1.8rem;
    border-radius: calc(var(--radius) + 6px);
    overflow: hidden;
    box-shadow: var(--shadow);
    aspect-ratio: 16 / 10;
    background: var(--dusk);
    animation: rise-in 0.8s var(--ease) both;
  }

  .how-stage video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .step {
    padding: 1.35rem 0;
    border-top: 1px solid var(--line);
    animation: rise-in 0.7s var(--ease) both;
  }

  .step:nth-child(2) {
    animation-delay: 0.08s;
  }

  .step:nth-child(3) {
    animation-delay: 0.16s;
  }

  .step-index {
    display: block;
    margin-bottom: 0.45rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--candy);
  }

  .step h3 {
    font-size: 1.55rem;
    margin-bottom: 0.4rem;
  }

  .step p {
    color: var(--ink-soft);
    max-width: 42ch;
  }

  @media (min-width: 900px) {
    .how-grid {
      grid-template-columns: 1.05fr 0.95fr;
      align-items: start;
      gap: 4rem;
    }
  }
</style>
